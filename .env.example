# Entorno
FLASK_ENV=development
SECRET_KEY=cambia_esta_clave

# Conexión Base de Datos MariaDB / MySQL
DB_USER=liga_user
DB_PASSWORD=cambia_esta_password
DB_ROOT_PASSWORD=cambia_esta_clave_root
DB_HOST=db
DB_PORT=3306
DB_NAME=liga_arbitros_db
DATABASE_URL=mysql+pymysql://liga_user:cambia_esta_password@db:3306/liga_arbitros_db?charset=utf8mb4

# Notificaciones al administrador (SMTP)
ADMIN_EMAIL=admin@liga.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Lector de horarios por visión (simulado no requiere conexión)
# VISION_PROVIDER: simulado | openrouter | gemini
VISION_PROVIDER=simulado
# Opción OpenRouter (clave sk-or-v1-...)
OPENROUTER_API_KEY=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
OPENROUTER_MODEL=google/gemini-2.5-flash
# Opción Google AI Studio (clave AIza...) para usar Gemini directamente
GEMINI_API_KEY=AQ.Ab8RN6KIw2yojv6QQCwwUPjannpk9gUSOwZ4J6npFQQdw6D_RA
GEMINI_MODEL=gemini-2.5-flash

# Telegram: el bot hace polling local y no necesita webhook público para probarse.
