# Entorno
FLASK_ENV=development
SECRET_KEY=cambia_esta_clave
AUTO_CREATE_DB=true

# Conexión Base de Datos MariaDB / MySQL
DB_USER=liga_user
DB_PASSWORD=cambia_esta_password
DB_ROOT_PASSWORD=cambia_esta_clave_root
DB_HOST=db
DB_PORT=3306
DB_NAME=liga_arbitros_db
DATABASE_URL=mysql+pymysql://liga_user:cambia_esta_password@db:3306/liga_arbitros_db?charset=utf8mb4

# Notificaciones al administrador (SMTP)
ADMIN_EMAIL=admin@liga.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Lector de horarios por visión (simulado no requiere conexión)
# VISION_PROVIDER: simulado | openrouter | gemini
VISION_PROVIDER=gemini

# Opción OpenRouter (agrega tu clave localmente; nunca la publiques)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.8-flash
# Opcional: credencial/modelo independientes para la normalización de texto (Excel/CSV).
# La clave tiene prioridad sobre OPENROUTER_API_KEY cuando se usa OpenRouter.
MIGRATION_AI_API_KEY=
MIGRATION_AI_MODEL=
# Opción Google AI Studio (agrega tu clave localmente; nunca la publiques)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Telegram: el bot hace polling local y no necesita webhook público para probarse.
# Nunca subas el token real al repositorio. Obtén uno nuevo desde @BotFather.
TELEGRAM_BOT_TOKEN=
# IDs numéricos de Telegram autorizados para aprobar/rechazar gastos; admite lista separada por comas.
TELEGRAM_ADMIN_IDS=
# Token opcional para proteger endpoints webhook/API de administración entre servicios.
BOT_WEBHOOK_TOKEN=
BCV_URL=https://www.bcv.org.ve/
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false
COOKIE_SAMESITE=Lax

# Frontend
# Ruta relativa: Vite reenvía /api al backend para compartir origen y cookie.
VITE_API_URL=/api
# Destino del proxy de Vite (en Docker el servicio se llama backend).
VITE_PROXY_TARGET=http://backend:5000
