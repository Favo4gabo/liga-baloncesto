# Entorno
FLASK_ENV=development
SECRET_KEY=cambia_esta_clave

# Conexión Base de Datos MariaDB / MySQL
DB_USER=liga_user
DB_PASSWORD=cambia_esta_password
DB_ROOT_PASSWORD=cambia_esta_clave_root
DB_HOST=db
DB_PORT=3306
DB_NAME=liga_arbitros_db
DATABASE_URL=mysql+pymysql://liga_user:cambia_esta_password@db:3306/liga_arbitros_db?charset=utf8mb4

# Notificaciones al administrador (SMTP)
ADMIN_EMAIL=admin@liga.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Frontend
VITE_API_URL=http://localhost:5000/api
