# Entorno
FLASK_ENV=development
SECRET_KEY=cambia_esta_clave

# Conexión Base de Datos MariaDB / MySQL
DB_USER=liga_user
DB_PASSWORD=cambia_esta_password
DB_ROOT_PASSWORD=cambia_esta_clave_root
DB_HOST=db
DB_PORT=3306
DB_NAME=liga_arbitros_db
DATABASE_URL=mysql+pymysql://liga_user:cambia_esta_password@db:3306/liga_arbitros_db?charset=utf8mb4

# Notificaciones al administrador (SMTP)
ADMIN_EMAIL=admin@liga.local
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true

# Lector de horarios por visión (simulado no requiere conexión; OpenRouter usa API key)
VISION_PROVIDER=simulado
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash

# Seguridad del webhook del bot; configura un secreto largo y aleatorio
BOT_WEBHOOK_TOKEN=
BCV_URL=https://www.bcv.org.ve/
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
COOKIE_SECURE=false

# Frontend
VITE_API_URL=http://localhost:5000/api
